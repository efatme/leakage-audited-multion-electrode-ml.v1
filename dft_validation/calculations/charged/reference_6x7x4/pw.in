  calculation = 'scf',
  prefix = 'c09_ch_k674',
  pseudo_dir = './pseudopotentials',
  outdir = './tmp',
  verbosity = 'high',
  disk_io = 'low',
  tstress = .true.,
  tprnfor = .true.,
/

&SYSTEM
  ibrav = 0,
  nat = 22,
  ntyp = 5,
  ecutwfc = 120.0,
  ecutrho = 960.0,
