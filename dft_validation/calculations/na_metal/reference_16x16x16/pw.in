&CONTROL
  calculation = 'scf',
  prefix = 'c07_na_k16',
  pseudo_dir = './pseudopotentials',
  outdir = './tmp',
  verbosity = 'high',
  disk_io = 'low',
  tstress = .true.,
  tprnfor = .true.,
/

&SYSTEM
  ibrav = 0,
  nat = 2,
  ntyp = 1,
  ecutwfc = 120.0,
  ecutrho = 960.0,
  input_dft = 'PBE',
  occupations = 'smearing',
  smearing = 'mv',
  degauss = 0.02000,
/

&ELECTRONS
  conv_thr = 1.0d-9,
  electron_maxstep = 400,
  mixing_mode = 'plain',
  mixing_beta = 0.30,
  diagonalization = 'david',
  startingpot = 'atomic',
/

ATOMIC_SPECIES
Na  22.989769280 na_pbe_v1.5.uspp.F.UPF

CELL_PARAMETERS angstrom
   4.2300000000000004  0.0000000000000000  0.0000000000000000
   0.0000000000000000  4.2300000000000004  0.0000000000000000
   0.0000000000000000  0.0000000000000000  4.2300000000000004

ATOMIC_POSITIONS crystal
Na   0.0000000000000000  0.0000000000000000  0.0000000000000000
Na   0.5000000000000000  0.5000000000000000  0.5000000000000000

K_POINTS automatic
16 16 16 0 0 0
