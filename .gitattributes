# Normalize text files across Windows/Linux while leaving binary artifacts untouched.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.cff text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.pdf binary
*.svg text eol=lf
*.gz binary
*.graphml text eol=lf
*.ipynb text eol=lf
